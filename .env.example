# CorpAssist configuration — copy to .env and adjust.
#   cp .env.example .env

# Model: llama3.1:8b is the default (more obedient; AI-01/02 land more reliably).
# qwen2.5:7b is the fallback if a model is being stubborn.
CORPASSIST_MODEL=llama3.1:8b

# --- Database: the DELIBERATELY over-privileged lab account (AI-03 / DB-03) ---
# Real lab (docker-compose.yml): point at the db-net MySQL VM, reached through
# pfSense's corp->db:3306 rule. Standalone override sets DB_HOST=mysql for you.
# corp-net is 192.168.50.0/24; the db-net MySQL VM is 172.16.0.10.
DB_HOST=172.16.0.10
DB_PORT=3306
DB_USER=dba_admin
DB_PASSWORD=dba123
DB_NAME=corp_sensitive

# --- Weak lab login accounts (deliberately weak) -----------------------------
# basic employee:  employee / employee123     admin:  hradmin / admin123
USER_EMPLOYEE_PW=employee123
USER_ADMIN_PW=admin123
